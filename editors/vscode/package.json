{
  "name": "shucked",
  "displayName": "Shucked",
  "description": "Shucked: Industry-grade Shellscript & ZSH Language Server, Linter, and Formatter",
  "author": "fredrir",
  "license": "MIT",
  "version": "0.0.9",
  "repository": {
    "type": "git",
    "url": "https://github.com/fredrir/shuck"
  },
  "bugs": {
    "url": "https://github.com/fredrir/shuck/issues"
  },
  "publisher": "fredrir",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "shell",
    "shellscript",
    "bash",
    "zsh",
    "sh",
    "linter",
    "formatter",
    "language-server",
    "shucked"
  ],
  "activationEvents": [
    "onLanguage:shellscript",
    "onLanguage:fish",
    "onLanguage:bash",
    "onLanguage:zsh",
    "onLanguage:sh",
    "onLanguage:ksh"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Native shell providers, terminal integration, and history suggestions require workspace trust.",
      "restrictedConfigurations": [
        "shucked.server.path",
        "shucked.server.extraArgs"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Shucked requires a filesystem and a native server on the workspace host."
    }
  },
  "workspaceTrust": {
    "supported": true
  },
  "contributes": {
    "keybindings": [
      {
        "key": "escape",
        "command": "shucked.dismissCompletion",
        "when": "editorTextFocus && shucked.completionPending"
      },
      {
        "key": "shift+escape",
        "command": "shucked.dismissCompletion",
        "when": "editorTextFocus && shucked.completionPending"
      },
      {
        "key": "down",
        "command": "shucked.navigateCompletion",
        "args": "selectNextSuggestion",
        "when": "editorTextFocus && suggestWidgetVisible && shucked.completionPending"
      },
      {
        "key": "up",
        "command": "shucked.navigateCompletion",
        "args": "selectPrevSuggestion",
        "when": "editorTextFocus && suggestWidgetVisible && shucked.completionPending"
      },
      {
        "key": "pagedown",
        "command": "shucked.navigateCompletion",
        "args": "selectNextPageSuggestion",
        "when": "editorTextFocus && suggestWidgetVisible && shucked.completionPending"
      },
      {
        "key": "pageup",
        "command": "shucked.navigateCompletion",
        "args": "selectPrevPageSuggestion",
        "when": "editorTextFocus && suggestWidgetVisible && shucked.completionPending"
      }
    ],
    "commands": [
      {
        "command": "shucked.restartServer",
        "title": "Shucked: Restart Language Server"
      },
      {
        "command": "shucked.showOutputChannel",
        "title": "Shucked: Show Language Server Logs"
      },
      {
        "command": "shucked.showVersion",
        "title": "Shucked: Show Version"
      },
      {
        "command": "shucked.selectEnvironment",
        "title": "Shucked: Select Execution Context"
      },
      {
        "command": "shucked.refreshEnvironment",
        "title": "Shucked: Refresh Environment"
      },
      {
        "command": "shucked.createTerminal",
        "title": "Shucked: Create Shell Terminal"
      },
      {
        "command": "shucked.attachTerminal",
        "title": "Shucked: Attach Shell Terminal"
      },
      {
        "command": "shucked.clearHistorySuggestions",
        "title": "Shucked: Clear History Suggestions"
      },
      {
        "command": "shucked.captureTarget",
        "title": "Shucked: Capture Execution Target"
      },
      {
        "command": "shucked.compareTargets",
        "title": "Shucked: Compare Execution Targets"
      }
    ],
    "configuration": {
      "title": "Shucked",
      "properties": {
        "shucked.fixAll.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable the 'Fix all auto-fixable issues' code action and on-save action."
        },
        "shucked.unsafeFixes.enable": {
          "type": "boolean",
          "default": false,
          "description": "Offer suggestions and quick fixes that may require manual review (unsafe fixes)."
        },
        "shucked.lint.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable background linting diagnostics."
        },
        "shucked.lint.showSyntaxErrors": {
          "type": "boolean",
          "default": true,
          "description": "Show shell syntax errors in problems and editor."
        },
        "shucked.format.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable shell script formatting."
        },
        "shucked.codeAction.disableRuleComment.enable": {
          "type": "boolean",
          "default": true,
          "description": "Show 'Disable for this line' and 'Disable for entire file' directive code actions."
        },
        "shucked.server.workspaceDiagnostics.enable": {
          "type": "boolean",
          "default": true,
          "description": "Run diagnostics across the entire workspace."
        },
        "shucked.server.workspaceSymbols.enable": {
          "type": "boolean",
          "default": true,
          "description": "Index workspace symbols for Go to Symbol in Workspace."
        },
        "shucked.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to custom shucked executable. Bundled platform binaries are the standard supported mode; custom binary paths are unsupported and provided as-is.",
          "examples": [
            "/usr/local/bin/shucked",
            "$HOME/.cargo/bin/shucked"
          ],
          "scope": "machine-overridable"
        },
        "shucked.server.extraArgs": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Extra CLI args for shucked server.",
          "scope": "machine-overridable"
        },
        "shucked.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the Shucked language server."
        },
        "shucked.server.completion.includeEnvironment": {
          "type": "boolean",
          "default": true,
          "description": "Complete commands and variable names from the language server host.",
          "scope": "resource"
        },
        "shucked.server.completion.includePaths": {
          "type": "boolean",
          "default": true,
          "description": "Complete paths relative to the selected launch directory.",
          "scope": "resource"
        },
        "shucked.server.completion.useShellConfig": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Legacy option. Personal startup files are not reloaded for editor completion requests.",
          "deprecationMessage": "Use Shucked: Create Shell Terminal or Attach Shell Terminal to share aliases and functions without reloading startup files while typing."
        },
        "shucked.server.completion.includeNative": {
          "type": "boolean",
          "default": true,
          "description": "Use installed and bundled shell completion providers, including Oh My Zsh. Requires workspace trust; personal startup files are not loaded."
        },
        "shucked.server.completion.includeCommandArguments": {
          "type": "boolean",
          "default": true,
          "description": "Complete flags, subcommands, and option values from installed and bundled upstream definitions.",
          "scope": "resource"
        },
        "shucked.server.completion.includeRuntimeNames": {
          "type": "boolean",
          "default": true,
          "description": "Complete runtime-provided shell variables.",
          "scope": "resource"
        },
        "shucked.server.completion.includeKeywords": {
          "type": "boolean",
          "default": true,
          "description": "Complete shell keywords.",
          "scope": "resource"
        },
        "shucked.server.completion.maxItems": {
          "type": "number",
          "default": 200,
          "description": "Maximum completion candidates per response.",
          "scope": "resource",
          "minimum": 1,
          "maximum": 2000
        },
        "shucked.environment.policy": {
          "type": "string",
          "enum": [
            "workspace",
            "portable"
          ],
          "default": "workspace",
          "scope": "resource",
          "description": "Workspace host checks by default; portable checks omit host absence warnings."
        },
        "shucked.environment.cwd": {
          "type": "string",
          "scope": "resource",
          "description": "Explicit script launch directory. The workspace folder is otherwise assumed."
        },
        "shucked.environment.targetInventory": {
          "type": "string",
          "scope": "resource",
          "description": "Captured target inventory on the workspace host."
        },
        "shucked.environment.declarations": {
          "type": "object",
          "scope": "resource",
          "default": {},
          "additionalProperties": {
            "type": "string",
            "enum": [
              "required",
              "optional",
              "generated",
              "deployment"
            ]
          },
          "description": "Expected project commands; declarations do not assert that a command is installed."
        },
        "shucked.history.session": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Suggest commands from explicitly attached shell sessions. Memory only; never executes a suggestion."
        },
        "shucked.history.files": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Read existing shell history files on this workspace host for inline suggestions. Memory only."
        }
      }
    },
    "languages": [
      {
        "id": "fish",
        "aliases": [
          "Fish",
          "fish"
        ],
        "extensions": [
          ".fish"
        ],
        "firstLine": "^#!.*\\bfish\\b"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "shellCommand",
        "superType": "function",
        "description": "Resolved shell command"
      },
      {
        "id": "shellAlias",
        "superType": "function",
        "description": "Shell alias"
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "invalid",
        "description": "Command unavailable in selected target"
      }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "shellCommand": [
            "entity.name.function.shell"
          ],
          "shellAlias": [
            "entity.name.function.alias.shell"
          ],
          "shellCommand.invalid": [
            "invalid.illegal.command.shell"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[shellscript]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.wordBasedSuggestions": "off"
      },
      "[fish]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.wordBasedSuggestions": "off"
      },
      "[bash]": { "editor.wordBasedSuggestions": "off" },
      "[zsh]": { "editor.wordBasedSuggestions": "off" },
      "[sh]": { "editor.wordBasedSuggestions": "off" },
      "[ksh]": { "editor.wordBasedSuggestions": "off" }
    },
    "terminal": {
      "profiles": [
        {
          "id": "shucked.terminal",
          "title": "Shucked shell",
          "icon": "terminal"
        }
      ]
    }
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.20.3",
    "@types/vscode": "^1.138.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0"
  },
  "scripts": {
    "vscode:prepublish": "bun run package",
    "bundle-bins": "node bundle-bins.mjs",
    "compile": "bun run check-types && bun run lint && bun run build",
    "build": "node esbuild.mjs",
    "watch": "bun run --parallel watch:esbuild watch:tsc",
    "watch:esbuild": "node esbuild.mjs --watch",
    "watch:tsc": "tsc --noEmit --watch",
    "package": "node bundle-bins.mjs && bun run check-types && bun run lint && node esbuild.mjs --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "vsix": "node vsix.mjs package",
    "publish": "node vsix.mjs publish",
    "test": "node --test --enable-source-maps tests/*.test.mjs",
    "test:coverage": "node --test --enable-source-maps --experimental-test-coverage --test-coverage-exclude=tests/** tests/*.test.mjs"
  }
}
